# Product and research documents stay on the maintainer's machine.
# The repository is public; these are not.
docs/

# Maintainer-only instructions. Absent from every clone and every install, by design.
#
# Path-independent on purpose. The sibling repo had this rule pinned to a literal path,
# and a directory rename stopped it matching — silently, with no error, putting private
# files one `git add -A` away from a public commit. An ignore rule a rename can switch
# off is not an ignore rule.
**/references/local/

.DS_Store
node_modules/
*.log
